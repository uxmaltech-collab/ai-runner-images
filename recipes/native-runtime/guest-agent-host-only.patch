@@ -0,0 +1,63 @@
+package vsock
+
+import (
+	"errors"
+	"io"
+	"net"
+	"strconv"
+	"testing"
+	"time"
+
+	"golang.org/x/sys/unix"
+)
+
+func TestAcceptHostOnlyClosesRejectedPeersAndContinues(t *testing.T) {
+	for _, cid := range []uint32{0, 1, 3, 42, ^uint32(0)} {
+		t.Run(strconv.FormatUint(uint64(cid), 10), func(t *testing.T) {
+			rejected, localPeer := net.Pipe()
+			defer localPeer.Close()
+			host, hostPeer := net.Pipe()
+			defer host.Close()
+			defer hostPeer.Close()
+			calls := 0
+			accepted, err := acceptHostOnly(func() (net.Conn, uint32, error) {
+				calls++
+				if calls == 1 {
+					return rejected, cid, nil
+				}
+				return host, unix.VMADDR_CID_HOST, nil
+			})
+			if err != nil || accepted != host || calls != 2 {
+				t.Fatalf("host acceptance after rejected CID %d: calls=%d err=%v", cid, calls, err)
+			}
+			_ = localPeer.SetReadDeadline(time.Now().Add(time.Second))
+			if _, err := localPeer.Read(make([]byte, 1)); !errors.Is(err, io.EOF) {
+				t.Fatalf("rejected CID %d connection remained open: %v", cid, err)
+			}
+			// A rejected peer must neither stop admission nor close the next host.
+			_ = hostPeer.SetWriteDeadline(time.Now().Add(time.Second))
+			written := make(chan error, 1)
+			go func() { _, err := hostPeer.Write([]byte("h")); written <- err }()
+			_ = accepted.SetReadDeadline(time.Now().Add(time.Second))
+			buffer := make([]byte, 1)
+			if _, err := accepted.Read(buffer); err != nil || string(buffer) != "h" {
+				t.Fatalf("accepted host channel was not usable: %v", err)
+			}
+			if err := <-written; err != nil {
+				t.Fatal(err)
+			}
+		})
+	}
+}
+
+func TestAcceptHostOnlyPreservesListenerFailure(t *testing.T) {
+	expected := errors.New("listener-closed")
+	calls := 0
+	connection, err := acceptHostOnly(func() (net.Conn, uint32, error) {
+		calls++
+		return nil, 0, expected
+	})
+	if connection != nil || !errors.Is(err, expected) || calls != 1 {
+		t.Fatalf("listener failure was not preserved: calls=%d err=%v", calls, err)
+	}
+}
