+++ b/internal/vsock/listener_exec_test.go
@@ -0,0 +1,131 @@
+package vsock
+
+import (
+	"context"
+	"fmt"
+	"net"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"strconv"
+	"strings"
+	"testing"
+	"time"
+
+	"golang.org/x/sys/unix"
+)
+
+// Exercise the same descriptor helpers with real sockets, without a VM or
+// credentials. The short path also fits Darwin's sockaddr_un limit.
+func unixTestListener(t *testing.T) (*os.File, int, string) {
+	t.Helper()
+	directory, err := os.MkdirTemp("/tmp", "vsock-exec-")
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = os.RemoveAll(directory) })
+	path := filepath.Join(directory, "socket")
+	fd, err := socketCloseOnExec(unix.AF_UNIX, unix.SOCK_STREAM, 0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, configure := range []func() error{
+		func() error { return unix.SetNonblock(fd, true) },
+		func() error { return unix.Bind(fd, &unix.SockaddrUnix{Name: path}) },
+		func() error { return unix.Listen(fd, 8) },
+	} {
+		if err := configure(); err != nil {
+			_ = unix.Close(fd)
+			t.Fatal(err)
+		}
+	}
+	file := os.NewFile(uintptr(fd), "test-listener")
+	t.Cleanup(func() { _ = file.Close() })
+	return file, fd, path
+}
+
+func TestSocketDescriptorsDoNotSurviveExec(t *testing.T) {
+	if path := os.Getenv("VSOCK_EXEC_TEST_PATH"); path != "" {
+		for _, value := range strings.Split(os.Getenv("VSOCK_EXEC_TEST_FDS"), ",") {
+			fd, err := strconv.Atoi(value)
+			if err != nil {
+				os.Exit(2)
+			}
+			peer, err := unix.Getsockname(fd)
+			// A descriptor number may have been reused by the child runtime;
+			// compare the unique socket address, not only its existence.
+			if address, ok := peer.(*unix.SockaddrUnix); err == nil && ok && address.Name == path {
+				_, _ = fmt.Fprintln(os.Stderr, "transport socket survived exec")
+				os.Exit(3)
+			}
+		}
+		os.Exit(0)
+	}
+	file, listeningFD, path := unixTestListener(t)
+	client, err := net.DialTimeout("unix", path, time.Second)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer client.Close()
+	acceptedFD, err := acceptCloseOnExec(file)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer unix.Close(acceptedFD)
+	for _, fd := range []int{listeningFD, acceptedFD} {
+		flags, err := unix.FcntlInt(uintptr(fd), unix.F_GETFD, 0)
+		if err != nil || flags&unix.FD_CLOEXEC == 0 {
+			t.Errorf("descriptor %d is inheritable: flags=%d err=%v", fd, flags, err)
+		}
+	}
+	executable, err := os.Executable()
+	if err != nil {
+		t.Fatal(err)
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+	defer cancel()
+	command := exec.CommandContext(ctx, executable, "-test.run=^TestSocketDescriptorsDoNotSurviveExec$")
+	command.Env = append(os.Environ(), "VSOCK_EXEC_TEST_PATH="+path,
+		fmt.Sprintf("VSOCK_EXEC_TEST_FDS=%d,%d", listeningFD, acceptedFD))
+	if output, err := command.CombinedOutput(); err != nil {
+		t.Fatalf("exec inherited a transport socket or failed: %v %s", err, output)
+	}
+}
+
+func TestIdleAcceptDoesNotBlockExecAndCloseReleasesIt(t *testing.T) {
+	file, _, _ := unixTestListener(t)
+	accepted := make(chan error, 1)
+	go func() {
+		fd, err := acceptCloseOnExec(file)
+		if fd >= 0 {
+			_ = unix.Close(fd)
+		}
+		accepted <- err
+	}()
+	// Confirm accept is waiting before starting a child; the timeout below
+	// must also unblock a faulty blocking Accept that holds the fork lock.
+	select {
+	case err := <-accepted:
+		t.Fatalf("empty listener did not wait: %v", err)
+	case <-time.After(50 * time.Millisecond):
+	}
+	executed := make(chan error, 1)
+	go func() { executed <- exec.Command("/usr/bin/true").Run() }()
+	select {
+	case err := <-executed:
+		if err != nil {
+			t.Error(err)
+		}
+	case <-time.After(5 * time.Second):
+		t.Error("idle accept blocked exec")
+	}
+	_ = file.Close()
+	select {
+	case err := <-accepted:
+		if err == nil {
+			t.Error("closed listener did not preserve accept failure")
+		}
+	case <-time.After(5 * time.Second):
+		t.Error("closing the listener did not release accept")
+	}
+}
