+func acceptCloseOnExec(file *os.File) (int, error) {
+	raw, err := file.SyscallConn()
+	if err != nil {
+		return -1, err
+	}
+	fd := -1
+	var acceptErr error
+	// File.Fd would switch the listener to blocking mode. Use the poller and
+	// release ForkLock before waiting, so an idle listener cannot stall exec.
+	err = raw.Read(func(listenerFD uintptr) bool {
+		for {
+			syscall.ForkLock.RLock()
+			fd, _, acceptErr = unix.Accept(int(listenerFD))
+			if acceptErr == nil {
+				_, acceptErr = unix.FcntlInt(uintptr(fd), unix.F_SETFD, unix.FD_CLOEXEC)
